{
  "name": "obs-replay-clip",
  "version": "1.0.0",
  "description": "Save + trim OBS replay buffer clips to a chosen length via obs-websocket",
  "author": "JSClipping",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "clip": "tsx src/cli/obs_replay_clip.ts",
    "prepare:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "dist": "npm run prepare:ffmpeg && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "obs-websocket-js": "^5.0.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
